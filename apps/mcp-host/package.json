{
  "name": "@kupuri/mcp-host",
  "version": "0.1.0",
  "private": true,
  "description": "MCP inline preview host \u2014 renders agent build outputs and MCP app surfaces",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test:mcp": "rm -rf dist-lib && tsc src/lib/mcp-core.ts --outDir dist-lib --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck && node --test test/mcp-core.test.mjs"
  },
  "dependencies": {
    "@kupuri/design-system": "workspace:*",
    "@kupuri/localization": "workspace:*",
    "@kupuri/shared-config": "workspace:*",
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
